{%- comment -%}
  Next Up Books editor (DRAFT, for testing only).
  Loads one self-contained script (assets/nub-storefront.js) that draws the
  story picker, character editor, book preview and cover choice inside the
  .nub-app box. Styles are scoped to .nub-app and do not affect the theme.
  With no products chosen below, the cart is a stand-in and checkout is off.
{%- endcomment -%}
<div class="nub-app">
  <a class="skip" href="#main">Skip to the book editor</a>
  <div class="devbar" role="note">{{ section.settings.notice | escape }}</div>
  <header class="site">
    <a class="logo" href="#/"><img src="{{ 'nub-logo.svg' | asset_url }}" alt="Next Up Books" width="224" height="40" style="display:block;height:40px;width:auto"></a>
    <nav aria-label="Next Up Books">
      <a href="#/">Stories</a>
      <a href="#/cart" id="cart-link">Cart (0)</a>
      <a href="#/content" class="dev-link">Content status</a>
    </nav>
  </header>
  <div id="main" tabindex="-1"></div>
  <div id="live" class="sr" aria-live="polite"></div>
  <noscript><p>The book editor needs JavaScript.</p></noscript>
  <footer class="site">
    <p>{{ section.settings.footer_note | escape }}</p>
    <p>{{ section.settings.footer_line | escape }}</p>
  </footer>
</div>

{%- assign dentist = section.settings.dentist_product -%}
{%- assign haircut = section.settings.haircut_product -%}
<script>
  window.NUB_SHOPIFY = {
    assets: {
      "nub-char-v1-wave-acc-glasses": { url: {{ 'nub-char-v1-wave-acc-glasses.png' | asset_img_url: '750x' | json }}, w: 1500, h: 2250 },
      "nub-char-v1-wave-body-s2": { url: {{ 'nub-char-v1-wave-body-s2.png' | asset_img_url: '750x' | json }}, w: 1500, h: 2250 },
      "nub-char-v1-wave-body-s5": { url: {{ 'nub-char-v1-wave-body-s5.png' | asset_img_url: '750x' | json }}, w: 1500, h: 2250 },
      "nub-char-v1-wave-hair-bob-black": { url: {{ 'nub-char-v1-wave-hair-bob-black.png' | asset_img_url: '750x' | json }}, w: 1500, h: 2250 },
      "nub-char-v1-wave-hair-bob-brown": { url: {{ 'nub-char-v1-wave-hair-bob-brown.png' | asset_img_url: '750x' | json }}, w: 1500, h: 2250 },
      "nub-char-v1-wave-hair-curls-black": { url: {{ 'nub-char-v1-wave-hair-curls-black.png' | asset_img_url: '750x' | json }}, w: 1500, h: 2250 },
      "nub-char-v1-wave-hair-curls-brown": { url: {{ 'nub-char-v1-wave-hair-curls-brown.png' | asset_img_url: '750x' | json }}, w: 1500, h: 2250 },
      "nub-char-v1-wave-outfit-cardigan": { url: {{ 'nub-char-v1-wave-outfit-cardigan.png' | asset_img_url: '750x' | json }}, w: 1500, h: 2250 },
      "nub-char-v1-wave-outfit-flower": { url: {{ 'nub-char-v1-wave-outfit-flower.png' | asset_img_url: '750x' | json }}, w: 1500, h: 2250 },
      "nub-dentist-cover-front-bg": { url: {{ 'nub-dentist-cover-front-bg.jpg' | asset_img_url: '1400x' | json }}, w: 2625, h: 2625 },
      "nub-dentist-p02-bg": { url: {{ 'nub-dentist-p02-bg.jpg' | asset_img_url: '1400x' | json }}, w: 2625, h: 2625 },
      "nub-dentist-p22-bg": { url: {{ 'nub-dentist-p22-bg.jpg' | asset_img_url: '1400x' | json }}, w: 2625, h: 2625 },
      "nub-dentist-p23-bg": { url: {{ 'nub-dentist-p23-bg.jpg' | asset_img_url: '1400x' | json }}, w: 2625, h: 2625 },
      "nub-dentist-card": { url: {{ 'nub-dentist-card.jpg' | asset_url | json }}, w: 766, h: 506 },
      "nub-haircut-card": { url: {{ 'nub-haircut-card.jpg' | asset_url | json }}, w: 762, h: 506 },
      "nub-school-card": { url: {{ 'nub-school-card.jpg' | asset_url | json }}, w: 766, h: 506 },
      "nub-airplane-card": { url: {{ 'nub-airplane-card.jpg' | asset_url | json }}, w: 762, h: 506 },
      "nub-fixture-p01-bg": { url: {{ 'nub-fixture-p01-bg.jpg' | asset_url | json }}, w: 1536, h: 1024 },
      "nub-fixture-child-full": { url: {{ 'nub-fixture-child-full.png' | asset_url | json }}, w: 512, h: 768 }
    },
    variants: {
      dentist: { {%- if dentist != blank -%}{%- for v in dentist.variants -%}{%- assign t = v.title | downcase -%}{%- if t contains 'soft' -%}softcover: {{ v.id }}, {%- endif -%}{%- if t contains 'hard' -%}hardcover: {{ v.id }}, {%- endif -%}{%- endfor -%}{%- endif -%} },
      haircut: { {%- if haircut != blank -%}{%- for v in haircut.variants -%}{%- assign t = v.title | downcase -%}{%- if t contains 'soft' -%}softcover: {{ v.id }}, {%- endif -%}{%- if t contains 'hard' -%}hardcover: {{ v.id }}, {%- endif -%}{%- endfor -%}{%- endif -%} }
    }
  };
</script>
<script type="module" src="{{ 'nub-storefront.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Next Up Books editor",
  "settings": [
    {
      "type": "text",
      "id": "notice",
      "label": "Notice bar",
      "default": "Draft for testing. Placeholder art. Not for sale."
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Footer note",
      "default": "For grown-ups: this is a picture book that helps a child see what a first experience might be like. It is not medical or therapeutic advice."
    },
    {
      "type": "text",
      "id": "footer_line",
      "label": "Footer line",
      "default": "Next Up Books. Printed by Linemark. Draft, not for publication."
    },
    {
      "type": "product",
      "id": "dentist_product",
      "label": "Dentist book product",
      "info": "Needs one variant named Softcover and one named Hardcover. Leave empty to keep the cart as a stand-in."
    },
    {
      "type": "product",
      "id": "haircut_product",
      "label": "Haircut book product",
      "info": "Needs one variant named Softcover and one named Hardcover."
    }
  ],
  "presets": [
    {
      "name": "Next Up Books editor"
    }
  ]
}
{% endschema %}
